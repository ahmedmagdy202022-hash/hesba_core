# Production-oriented example. Local development works without an .env file.
DEBUG=False
SECRET_KEY=replace-with-a-long-random-production-secret
# Domains live under nuzmtech.com (docs/DOMAINS.md): demo.hesba.nuzmtech.com, <client>.hesba.nuzmtech.com
ALLOWED_HOSTS=client.hesba.nuzmtech.com
CSRF_TRUSTED_ORIGINS=https://client.hesba.nuzmtech.com
PUBLIC_BASE_URL=https://client.hesba.nuzmtech.com

DATABASE_BACKEND=postgresql
POSTGRES_DB=hesba
POSTGRES_USER=hesba
POSTGRES_PASSWORD=replace-with-a-database-secret
POSTGRES_HOST=database.example.internal
POSTGRES_PORT=5432
POSTGRES_SSLMODE=require
DATABASE_CONN_MAX_AGE=60

STATIC_ROOT=staticfiles
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=False
TRUST_PROXY_SSL_HEADER=True

# OPS-001
ADMIN_URL=change-me-private-admin/
BACKUP_DIR=/var/backups/hesba
BACKUP_KEEP=14
LOG_LEVEL=WARNING

# SEC-001: sign-in protection and idle sign-out
SESSION_IDLE_HOURS=10
LOGIN_MAX_FAILURES=5
LOGIN_MAX_FAILURES_PER_IP=20
LOGIN_LOCK_MINUTES=15

# SHARE-001: days a shared invoice/statement link stays valid
SHARE_LINK_DAYS=60

# S4 (HG-070): online payment link (Paymob). Keys go in the server's environment only, never in the repository.
# A real Paymob call needs PAYMOB_LIVE=True and all four keys; PAYMENT_GATEWAY_MOCK=True is for development only.
PAYMOB_LIVE=False
PAYMOB_API_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_INTEGRATION_ID=
PAYMOB_IFRAME_ID=
PAYMENT_GATEWAY_MOCK=False
PAYMENT_LINK_HOURS=72

# A0 (HG-078): AI provider layer. AI_MODE=mock|live|off; empty means mock with DEBUG on and off with DEBUG off.
# Live needs ELEVENLABS_API_KEY and a real ELEVENLABS_VOICE_ID. Keys go in the server's environment only.
AI_MODE=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=hesba-placeholder-voice
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
