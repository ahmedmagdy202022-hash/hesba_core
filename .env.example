# Production-oriented example. Local development works without an .env file.
DEBUG=False
SECRET_KEY=replace-with-a-long-random-production-secret
ALLOWED_HOSTS=hesba.example.com
CSRF_TRUSTED_ORIGINS=https://hesba.example.com

DATABASE_BACKEND=postgresql
POSTGRES_DB=hesba
POSTGRES_USER=hesba
POSTGRES_PASSWORD=replace-with-a-database-secret
POSTGRES_HOST=database.example.internal
POSTGRES_PORT=5432
POSTGRES_SSLMODE=require
DATABASE_CONN_MAX_AGE=60

STATIC_ROOT=staticfiles
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=False
TRUST_PROXY_SSL_HEADER=True

# OPS-001
ADMIN_URL=change-me-private-admin/
BACKUP_DIR=/var/backups/hesba
BACKUP_KEEP=14
LOG_LEVEL=WARNING

# SEC-001: sign-in protection and idle sign-out
SESSION_IDLE_HOURS=10
LOGIN_MAX_FAILURES=5
LOGIN_MAX_FAILURES_PER_IP=20
LOGIN_LOCK_MINUTES=15
