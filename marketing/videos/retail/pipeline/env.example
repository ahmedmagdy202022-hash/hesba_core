# Local demo server for filming. Copy to env.sh, replace <work dir>, and set SECRET_KEY to any local dummy value.
export DEMO_MODE=True
export DEMO_SANDBOXES=True
export DEBUG=False
export SECRET_KEY=<any local dummy value>
export ALLOWED_HOSTS=localhost,127.0.0.1
export DATABASE_BACKEND=sqlite
export SQLITE_PATH=<work dir>/env/demo.sqlite3
export FEEDBACK_SQLITE_PATH=<work dir>/env/feedback.sqlite3
export DEMO_SANDBOX_DIR=<work dir>/env/boxes
export STATIC_ROOT=<work dir>/env/static
export SECURE_SSL_REDIRECT=False
export SESSION_COOKIE_SECURE=False
export CSRF_COOKIE_SECURE=False
export SECURE_HSTS_SECONDS=0
export PYTHONDONTWRITEBYTECODE=1
export PORT=8099
export PUBLIC_BASE_URL=http://127.0.0.1:8099
